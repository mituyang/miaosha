# Server
SERVER_PORT=8080
STARTUP_FLUSH_REDIS_ON_START=false

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=seckill
MYSQL_USER=root
MYSQL_PASSWORD=change_me

# Redis
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_TOPIC=seckill_orders
KAFKA_GROUP=seckill_consumer_group

# Auth
JWT_SECRET=change_me
JWT_EXPIRE_HOURS=24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_unique_admin_password

# QQ email SMTP
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_qq_email@qq.com
EMAIL_PASSWORD=your_qq_mail_smtp_authorization_code
EMAIL_FROM=your_qq_email@qq.com
EMAIL_FROM_NAME=秒杀系统
EMAIL_ENCRYPTION=starttls
EMAIL_CODE_LENGTH=6
EMAIL_CODE_TTL=5m
EMAIL_SEND_INTERVAL=60s
EMAIL_SUBJECT=秒杀系统验证码
